+void mixroomIOSUpdatePolicyFacts(
+    MixroomIOSAudioSessionPolicyStatus status,
+    int activationCount,
+    double elapsedMilliseconds) noexcept
+{
+    const std::lock_guard<std::mutex> lock(mixroomIOSPolicyMutex);
+    mixroomIOSPolicyFacts.status = status;
+    mixroomIOSPolicyFacts.activationCount = activationCount;
+    mixroomIOSPolicyFacts.mutationElapsedMilliseconds = elapsedMilliseconds;
