+
+void mixroomIOSMarkPreparedSession(
+    MixroomIOSAudioSessionPolicy policy) noexcept
+{
+    const std::lock_guard<std::mutex> lock(mixroomIOSPolicyMutex);
+    mixroomIOSPreparedSessionPolicy = policy;
+    mixroomIOSPreparedSessionActive = true;
+}
+
+bool mixroomIOSConsumePreparedSession(
+    MixroomIOSAudioSessionPolicy policy) noexcept
+{
+    const std::lock_guard<std::mutex> lock(mixroomIOSPolicyMutex);
+    if (!mixroomIOSPreparedSessionActive ||
+        mixroomIOSPreparedSessionPolicy != policy)
+        return false;
+    mixroomIOSPreparedSessionActive = false;
+    return true;
+}
+
+void mixroomIOSClearPreparedSession() noexcept
+{
+    const std::lock_guard<std::mutex> lock(mixroomIOSPolicyMutex);
+    mixroomIOSPreparedSessionActive = false;
+    mixroomIOSPreparedSessionPolicy =
+        MixroomIOSAudioSessionPolicy::legacyManaged;
