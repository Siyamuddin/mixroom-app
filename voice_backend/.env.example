# Generate a private .env with: python3 scripts/setup_env.py
MIXROOM_PASSWORD=replace-with-at-least-12-random-characters
MIXROOM_DATA_DIR=/data
# Exact browser origins only. Add the published Lovable origin before using it.
MIXROOM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05
# Optional classification; absence is reported and uses OpenAI directly.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
