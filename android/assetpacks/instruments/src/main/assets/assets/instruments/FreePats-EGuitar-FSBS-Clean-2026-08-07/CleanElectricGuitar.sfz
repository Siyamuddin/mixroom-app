<region> sample=B3_s5_01.mp3  lokey=57 hikey=61 pitch_keycenter=59
<region> sample=E4_s6_01.mp3  lokey=62 hikey=65 pitch_keycenter=64
<region> sample=G4_s6_01.mp3  lokey=66 hikey=69 pitch_keycenter=67
<region> sample=B4_s6_01.mp3  lokey=70 hikey=72 pitch_keycenter=71
<region> sample=D5_s6_01.mp3  lokey=73 hikey=76 pitch_keycenter=74
