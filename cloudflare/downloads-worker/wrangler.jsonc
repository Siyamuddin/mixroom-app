{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "downloads",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "mixroom-downloads-prod"
    }
  ]
}
